# FISHARCHY pinned inputs, read by build-fisharchy.sh. Edit here, not in the script.
# Run `./build-fisharchy.sh --pin` after a good build to replace the refs below with the exact commits used.

FISHARCHY_VERSION=1.0.0

# Official omarchy-iso builder commit (must also accept iso/fisharchy.patch).
OMARCHY_ISO_COMMIT=38d8d05537a2442a73a92c0e1ccce0fb670f369a

# Custom package sources. HEAD or a branch name floats (HEAD = the repo's default branch, whatever it is called); a full commit SHA pins. Private repos: owner only.
BRANDING_REF=HEAD
FISH_THEME_REF=HEAD
FISHYLAYOUT_REF=HEAD
# Public upstream plugin packaged by packages/omarchy-radio-atlas.
RADIO_ATLAS_REF=HEAD

# --netinstall: small ISO (about 1.4 GiB) that installs stock Omarchy over the network, with a Wi-Fi step.
# This is an UNOFFICIAL third-party builder branch (omacom/omarchy-iso pull request 256, closed upstream).
# It is pinned to an exact commit so a later change to that branch cannot alter your build.
NETINSTALL_ISO_REPO=https://github.com/Tsurgcom/omarchy-iso.git
NETINSTALL_ISO_COMMIT=c45937fdd0a6217f64bdde4ecac534dc13cff308
