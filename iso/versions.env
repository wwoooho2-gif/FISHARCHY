# FISHARCHY pinned inputs, read by build-fisharchy.sh. Edit here, not in the script.
# Run `./build-fisharchy.sh --pin` after a good build to replace the refs below with the exact commits used.

FISHARCHY_VERSION=1.0.0

# Official omarchy-iso builder commit (must also accept iso/fisharchy.patch).
OMARCHY_ISO_COMMIT=38d8d05537a2442a73a92c0e1ccce0fb670f369a

# Custom package sources. A branch name floats; a full commit SHA pins. Private repos: owner only.
BRANDING_REF=main
FISH_THEME_REF=main
FISHYLAYOUT_REF=main
# Public upstream plugin packaged by packages/omarchy-radio-atlas.
RADIO_ATLAS_REF=main
