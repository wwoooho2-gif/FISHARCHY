# FISHARCHY pinned inputs, read by build-fisharchy.sh.
# Each value is a full 40-character commit SHA (reproducible), or a branch/tag
# name (NOT reproducible: the build warns). After a known-good build run
#   ./build-fisharchy.sh --record-pins
# to rewrite the *_REF line below with the exact commits that were built.

# Official Omarchy ISO builder; iso/fisharchy.patch is written against this commit.
OMARCHY_ISO_COMMIT=38d8d05537a2442a73a92c0e1ccce0fb670f369a

# Private package repository (only the owner can clone it).
BOOT_BRANDING_REF=main

