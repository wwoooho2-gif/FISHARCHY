diff --git i/builder/prune-firmware.sh w/builder/prune-firmware.sh
new file mode 100644
index 0000000..e162587
--- /dev/null
+++ w/builder/prune-firmware.sh
@@ -0,0 +1,37 @@
+#!/bin/bash
+
+set -euo pipefail
+
+root=${1:-}
+if [[ -z $root ]]; then
+  echo "Usage: prune-firmware.sh <root>" >&2
+  exit 1
+fi
+
+fw="$root/usr/lib/firmware"
+[[ -d $fw ]] || exit 0
+
+find "$fw" -mindepth 1 -maxdepth 1 \
+  ! -name nvidia ! -name intel ! -name intel-ucode ! -name rtl_nic \
+  ! -name regulatory.db ! -name regulatory.db.p7s \
+  -exec rm -rf {} +
+
+if [[ -d $fw/intel ]]; then
+  find "$fw/intel" -mindepth 1 -maxdepth 1 \
+    ! -name iwlwifi ! -name 'ibt-*' \
+    -exec rm -rf {} +
+fi
+
+if [[ -d $fw/intel/iwlwifi ]]; then
+  find "$fw/intel/iwlwifi" -type f ! -name '*gf*' -delete
+fi
+
+if [[ -d $fw/nvidia ]]; then
+  find "$fw/nvidia" -mindepth 1 -maxdepth 1 ! -name '[0-9]*' -exec rm -rf {} +
+  for version_dir in "$fw"/nvidia/[0-9]*/; do
+    [[ -d $version_dir ]] || continue
+    find "$version_dir" -mindepth 1 -maxdepth 1 ! -name '*ga10x*' -exec rm -rf {} +
+  done
+fi
+
+find "$fw" -mindepth 1 -type d -empty -delete
