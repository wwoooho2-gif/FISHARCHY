diff --git i/bin/omarchy-iso-make w/bin/omarchy-iso-make
index 5a3fc87..6d1b4a7 100755
--- i/bin/omarchy-iso-make
+++ w/bin/omarchy-iso-make
@@ -240,6 +240,14 @@ DOCKER_ARGS=(
   -v "$BUILD_ROOT/configs:/configs:ro"
 )
 
+# FISHARCHY: locally built packages the build script stages into the offline
+# mirror and bakes into the root image.
+CUSTOM_PACKAGES_PATH="$BUILD_ROOT/custom-packages"
+if [[ -d $CUSTOM_PACKAGES_PATH ]]; then
+  CUSTOM_PACKAGES_PATH=$(realpath "$CUSTOM_PACKAGES_PATH")
+  DOCKER_ARGS+=(-v "$CUSTOM_PACKAGES_PATH:/custom-packages:ro")
+fi
+
 if [[ -n $LOCAL_OMARCHY_PATH ]]; then
   DOCKER_ARGS+=(
     -v "$LOCAL_OMARCHY_PATH:/omarchy-source:ro"
diff --git i/builder/build-iso.sh w/builder/build-iso.sh
index 0685dbc..e8bf112 100755
--- i/builder/build-iso.sh
+++ w/builder/build-iso.sh
@@ -207,6 +207,33 @@ build_cache_dir=/var/cache
 offline_mirror_dir="$build_cache_dir/airootfs/var/cache/omarchy/mirror/offline"
 mkdir -p "$build_cache_dir" "$offline_mirror_dir"
 
+# Custom packages built for this ISO. They are staged in the offline mirror
+# only; the online databases know nothing about them, so they are kept out of
+# the download transaction and added back to the keep-set by hand below.
+CUSTOM_PACKAGES=(
+  omarchy-boot-branding
+  omarchy-fish-theme
+  omarchy-fishylayout
+  omarchy-radio-atlas
+  omarchy-no-preinstalls
+)
+if [[ ! -d /custom-packages ]]; then
+  echo "ERROR: /custom-packages is not mounted; the custom Omarchy packages would be missing" >&2
+  exit 1
+fi
+for custom_package in "${CUSTOM_PACKAGES[@]}"; do
+  found_custom=0
+  for archive in /custom-packages/"$custom_package"-*.pkg.tar.*; do
+    [[ -f $archive && $archive != *.sig ]] || continue
+    cp -f -- "$archive" "$offline_mirror_dir/"
+    found_custom=1
+  done
+  if (( ! found_custom )); then
+    echo "ERROR: no package archive for $custom_package in /custom-packages" >&2
+    exit 1
+  fi
+done
+
 # Seed from the official Arch releng profile.
 cp -r /archiso/configs/releng/* "$build_cache_dir/"
 rm "$build_cache_dir/airootfs/etc/motd"
@@ -504,6 +531,35 @@ if [[ $OMARCHY_ARCH == aarch64 ]]; then
   base_pkg_lists[0]=$aarch64_base_list
 fi
 
+# A clean FISHARCHY install: keep Omarchy's preinstalled desktop apps, web
+# apps, and TUI wrappers out of the install sets, so neither the root image nor
+# the target install carries them. omarchy-no-preinstalls removes the seeded
+# launchers and records the same opt-out marker as `omarchy remove preinstalls`.
+PREINSTALL_PACKAGES=(
+  aether cliamp libreoffice-fresh pinta obsidian moonlight-qt
+  omacut monologue omacalc omawrite hype signed
+)
+strip_preinstall_packages() {
+  local list=$1 filtered
+  [[ -f $list ]] || return 0
+  filtered="/tmp/$(basename "${list%.packages}").no-preinstalls.packages"
+  grep -Fxv -f <(printf '%s\n' "${PREINSTALL_PACKAGES[@]}") "$list" >"$filtered" || true
+  printf '%s\n' "$filtered"
+}
+base_pkg_lists[0]=$(strip_preinstall_packages "${base_pkg_lists[0]}")
+if (( ${#platform_lists[@]} > 0 )); then
+  for i in "${!platform_lists[@]}"; do
+    platform_lists[i]=$(strip_preinstall_packages "${platform_lists[$i]}")
+  done
+fi
+if [[ -n ${platform_base_dir:-} && -d $platform_base_dir ]]; then
+  for platform_base in "$platform_base_dir"/omarchy-base.*.packages; do
+    [[ -f $platform_base ]] || continue
+    filtered=$(strip_preinstall_packages "$platform_base")
+    mv -- "$filtered" "$platform_base"
+  done
+fi
+
 mkdir -p "$build_cache_dir/airootfs/usr/share/omarchy-iso"
 cp "${base_pkg_lists[0]}" "$build_cache_dir/airootfs/usr/share/omarchy-iso/omarchy-base.packages"
 cp "${base_pkg_lists[1]}" "$build_cache_dir/airootfs/usr/share/omarchy-iso/omarchy-other.packages"
@@ -644,6 +700,17 @@ mapfile -t target_packages < <(
   } | sed 's/^broadcom-wl$/broadcom-wl-dkms/' | sort -u
 )
 
+# The custom packages are not in the synced online databases; they are already
+# in the offline mirror and are added to the keep-set directly below.
+mapfile -t all_packages < <(
+  printf '%s\n' "${all_packages[@]}" |
+    grep -Fxv -f <(printf '%s\n' "${CUSTOM_PACKAGES[@]}") || true
+)
+mapfile -t target_packages < <(
+  printf '%s\n' "${target_packages[@]}" |
+    grep -Fxv -f <(printf '%s\n' "${CUSTOM_PACKAGES[@]}") || true
+)
+
 # x86_64: Omarchy's optional list also names packages for aarch64 boards,
 # which have no x86_64 build. Each exclusion is explicit and printed, and the
 # list is a file of its own so it can be read without parsing this script.
@@ -859,6 +926,27 @@ if [[ -n ${LOCAL_OMARCHY_BUILD:-} ]]; then
   done
 fi
 
+# Keep the exact custom archives staged above. They are not part of the online
+# transaction, so without this the prune would delete them again.
+for custom_package in "${CUSTOM_PACKAGES[@]}"; do
+  custom_file=""
+  for candidate in "$offline_mirror_dir/$custom_package-"*.pkg.tar.*; do
+    [[ -f $candidate && $candidate != *.sig ]] || continue
+    read -r candidate_name _ < <(pacman -Qp "$candidate" 2>/dev/null) || continue
+    [[ $candidate_name == "$custom_package" ]] || continue
+    if [[ -n $custom_file ]]; then
+      echo "ERROR: multiple custom builds found for $custom_package" >&2
+      exit 1
+    fi
+    custom_file="${candidate##*/}"
+  done
+  if [[ -z $custom_file ]]; then
+    echo "ERROR: custom build not found for $custom_package" >&2
+    exit 1
+  fi
+  required_package_files+=("$custom_file")
+done
+
 printf '%s\n' "${required_package_files[@]}" |
   bash /builder/prune-offline-mirror.sh "$offline_mirror_dir"
 
